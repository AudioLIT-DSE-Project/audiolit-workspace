import { test, expect, type Page } from "@playwright/test";
import AxeBuilder from "@axe-core/playwright";
import { writeFileSync, mkdirSync } from "fs";
import path from "path";

/**
 * Accessibility checks for section 3.1.3 (User Interface Testing) of the
 * Master Test Plan. Runs axe-core against the workbench in the same
 * backend-free way layout.spec.ts does, so it stays in the fast projects.
 *
 * WCAG 2.1 A and AA are the scored rule sets. "best-practice" rules are
 * collected too but reported separately, because they are advisory and
 * failing the suite on them would make it permanently red.
 *
 * Two states are scanned. The first-run state has the quick-start dialog
 * open over the workbench (LIT-261), which is a modal and hides the page
 * behind it from the scan. Dismissing it the way a returning user would,
 * by setting the same localStorage key the dialog itself writes, exposes
 * the workbench underneath. Both states are real, so both are scanned.
 */
const SCORED_TAGS = ["wcag2a", "wcag2aa", "wcag21a", "wcag21aa"];
const QUICKSTART_DISMISSED_KEY = "audiolit.quickstart.dismissed";
const REPORT_DIR = path.join(process.cwd(), "test-results", "accessibility");

type AxeViolation = { id: string; impact?: string | null; nodes: unknown[] };

const summarise = (violations: AxeViolation[]) =>
  violations.map((v) => `${v.id} [${v.impact ?? "n/a"}] x${v.nodes.length}`).join("\n") || "none";

function record(name: string, results: { violations: AxeViolation[]; passes: unknown[]; incomplete: AxeViolation[] }) {
  mkdirSync(REPORT_DIR, { recursive: true });
  writeFileSync(path.join(REPORT_DIR, `${name}.json`), JSON.stringify(results, null, 2));
  console.log(`--- ${name} ---`);
  console.log(`SCORED VIOLATIONS: ${results.violations.length}`);
  console.log(summarise(results.violations));
  console.log(`PASSED CHECKS: ${results.passes.length}`);
  console.log(`INCOMPLETE (needs manual review): ${results.incomplete.length}`);
  console.log(summarise(results.incomplete));
}

async function dismissQuickStart(page: Page) {
  await page.addInitScript((key) => {
    window.localStorage.setItem(key, "true");
  }, QUICKSTART_DISMISSED_KEY);
}

test.describe("Accessibility - axe-core automated scan", () => {
  test("first-run state (quick-start dialog open) has no scored WCAG 2.1 A/AA violations", async ({ page }) => {
    await page.goto("/");
    await page.waitForLoadState("networkidle");

    const results = await new AxeBuilder({ page }).withTags(SCORED_TAGS).analyze();
    record("first-run", results);

    expect(results.violations, summarise(results.violations)).toEqual([]);
  });

  test("workbench state (dialog dismissed) has no scored WCAG 2.1 A/AA violations", async ({ page }) => {
    await dismissQuickStart(page);
    await page.goto("/");
    await page.waitForLoadState("networkidle");

    const results = await new AxeBuilder({ page }).withTags(SCORED_TAGS).analyze();
    record("workbench", results);

    expect(results.violations, summarise(results.violations)).toEqual([]);
  });

  test("records best-practice advisories without failing the run", async ({ page }) => {
    await dismissQuickStart(page);
    await page.goto("/");
    await page.waitForLoadState("networkidle");

    const results = await new AxeBuilder({ page }).withTags(["best-practice"]).analyze();
    record("best-practice", results);

    // Advisory only: the assertion is that the scan ran, not that it was clean.
    expect(Array.isArray(results.violations)).toBe(true);
  });

  test("keyboard focus reaches the primary controls", async ({ page }) => {
    await dismissQuickStart(page);
    await page.goto("/");
    await page.waitForLoadState("networkidle");

    const reached: string[] = [];
    for (let i = 0; i < 15; i++) {
      await page.keyboard.press("Tab");
      const el = await page.evaluate(() => {
        const a = document.activeElement;
        if (!a || a === document.body) return null;
        return `${a.tagName.toLowerCase()}:${(a.textContent || "").trim().slice(0, 30)}`;
      });
      if (el) reached.push(el);
    }

    console.log(`TAB-REACHABLE ELEMENTS (15 presses): ${reached.length}`);
    console.log([...new Set(reached)].join("\n"));
    expect(reached.length).toBeGreaterThan(0);
  });
});
